    <!-- À propos & Confidentialité -->
    <string name="about_privacy_title">À propos &amp; Confidentialité</string>
    <string name="about_offline_title">🔒 100% Hors-ligne &amp; Respect de la vie privée</string>
    <string name="about_offline_desc">Cette application ne requiert aucune connexion réseau, aucun compte, ne transmet aucune donnée et ne contient aucun tracker publicitaire.</string>
    <string name="about_physics_title">⚙️ Science du pneu &amp; Modèle Open Source</string>
    <string name="about_physics_desc" formatted="false">Algorithme open source fondé sur les recherches de Frank Berto (fléchissement optimal à 15%), la modélisation de l\'impédance de roulement et les normes de sécurité ETRTO / ISO. Recommandations fiables calculées 100% hors-ligne.</string>
