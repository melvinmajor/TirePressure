    <string name="onboarding_welcome_title">Welcome to TirePressure</string>
    <string name="onboarding_welcome_desc">Optimize your rolling resistance, traction and comfort with open-source scientific tire drop calculations.</string>
    <string name="onboarding_weight_prompt">To get started, what is your regular riding weight?</string>
    <string name="onboarding_weight_desc">This weight serves as the benchmark to calculate ideal tire pressures for all your bikes and wheelsets. You can edit it anytime in Settings.</string>
