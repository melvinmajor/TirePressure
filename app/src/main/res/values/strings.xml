    <!-- App Info Screen -->
    <string name="app_info_title">App Info</string>
    <string name="app_info_github_title">GitHub</string>
    <string name="app_info_github_url">melvinmajor/TirePressure</string>
    <string name="app_info_algorithm_title">📐 Frank Berto Algorithm Adaptations</string>
    <string name="app_info_algorithm_desc">Frank Berto\'s classical formula was designed for static trainer equilibrium. TirePressure enhances it with dynamic compliance, rolling impedance break-points, internal rim width influence, and ETRTO hookless safety boundaries.\n\nTo ensure realistic pressures across diverse modern disciplines (Road, Gravel, Enduro, Downhill), our model is calibrated against real-world industry reference benchmarks (such as SRAM AXS App reference points) while maintaining its own 100% clean-room, open-source mathematical physics implementation computed fully offline.</string>

