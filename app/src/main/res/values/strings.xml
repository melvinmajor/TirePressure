    <!-- About & Privacy -->
    <string name="about_privacy_title">About &amp; Privacy</string>
    <string name="about_offline_title">🔒 100% Offline • Zero Tracking</string>
    <string name="about_offline_desc">This application requires no internet connection, no account, transmits zero data, and contains no ads or trackers.</string>
    <string name="about_physics_title">⚙️ Tire Physics &amp; Open Source Model</string>
    <string name="about_physics_desc" formatted="false">Open source algorithm based on Frank Berto\'s research (15% optimal tire drop deflection), rolling impedance modeling, and ETRTO / ISO safety standards. Reliable recommendations calculated 100% offline.</string>
    <string name="about_version_license">Version %1$s • Open Source (MIT License)</string>
