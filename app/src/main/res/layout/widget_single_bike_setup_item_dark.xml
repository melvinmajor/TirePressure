<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_card_dark"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Setup Title & Warning -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/setup_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#F2F5F8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_item_style_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_discipline_dark"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="#D4FF00"
            android:textSize="9sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/setup_item_warning"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Warning"
            android:src="@drawable/ic_widget_warning"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Pressures: Front & Rear Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <!-- Front Wheel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pressure_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/setup_front_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_discipline_dark"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="AV"
                android:textColor="#CBD5E1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setup_front_dry_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#D4FF00"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rear Wheel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pressure_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/setup_rear_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_discipline_dark"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="AR"
                android:textColor="#CBD5E1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setup_rear_dry_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#D4FF00"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Wet condition subtext -->
    <TextView
        android:id="@+id/setup_wet_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="end"
        android:textColor="#8B949E"
        android:textSize="10sp" />
</LinearLayout>
