<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/all_bikes_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_dark"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Bike Name & Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_bike_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#F2F5F8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_bike_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_discipline_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="#D4FF00"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_bike_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Setup 1 container -->
    <LinearLayout
        android:id="@+id/item_setup1_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_pressure_pill_dark"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/item_setup1_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_setup1_pressures"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D4FF00"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_setup1_wet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8B949E"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Setup 2 container (if exists) -->
    <LinearLayout
        android:id="@+id/item_setup2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_pressure_pill_dark"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/item_setup2_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_setup2_pressures"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D4FF00"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_setup2_wet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8B949E"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
