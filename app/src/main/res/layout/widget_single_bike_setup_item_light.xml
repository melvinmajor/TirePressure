<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_light"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Setup Title, Discipline Badge & Hookless Warning -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/setup_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#0E1217"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_item_style_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_discipline_light"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="#57606A"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/setup_item_warning"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Warning"
            android:src="@drawable/ic_widget_warning"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Pressures: Front & Rear Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Front Wheel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pressure_pill_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/setup_front_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_discipline_light"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="@string/widget_front_abbr"
                android:textColor="#5A7500"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setup_front_dry_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="#5A7500"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rear Wheel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pressure_pill_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/setup_rear_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_discipline_light"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="@string/widget_rear_abbr"
                android:textColor="#5A7500"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setup_rear_dry_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="#5A7500"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Wet / Snow condition subtext -->
    <TextView
        android:id="@+id/setup_wet_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:gravity="end"
        android:textColor="#57606A"
        android:textSize="10sp" />
</LinearLayout>
